<Control xmlns="https://spacestation14.io"
         xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         HorizontalExpand="True">
    <BoxContainer Orientation="Vertical" Margin="10 0 10 10">
        <controls:SplitBar Name="ReagentBar"
                           MinHeight="15"
                           VerticalExpand="False"
                           HorizontalExpand="True"
                           Margin="0 0 0 -5"/>
        <Button Disabled="True"
                HorizontalExpand="True"
                VerticalExpand="True"
                StyleClasses="ButtonSquare"
                Margin="0">
            <BoxContainer Orientation="Vertical"
                          VerticalExpand="True"
                          Margin="5">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <TextureRect Name="FormulaTypeTexture"
                                 TextureScale="2 2"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" Margin="10 0 0 0">
                        <BoxContainer Orientation="Horizontal">
                            <Label Name="FormulaNameLabel" StyleClasses="LabelKeyText" HorizontalExpand="True"/>
                        </BoxContainer>
                        <customControls:HSeparator StyleClasses="LowDivider" Margin="0 5 0 5"/>
                        <BoxContainer Orientation="Horizontal">
                            <RichTextLabel Name="FormulaTypeLabel" HorizontalAlignment="Left" StyleClasses="LabelSubText" HorizontalExpand="True"/>
                            <Button Name="EditButton" Text="{Loc 'formulator-window-edit'}" StyleClasses="OpenRight"/>
                            <Button Name="FormulateButton" Text="{Loc 'formulator-window-formulate'}" StyleClasses="OpenLeft"/>
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
                <Control MinHeight="5"></Control>
                <RichTextLabel HorizontalExpand="True" StyleClasses="LabelSubText" Text="{Loc 'formulator-window-reagents'}"/>
                <BoxContainer Name="FormulaReagents" Orientation="Vertical"/>
            </BoxContainer>
        </Button>
    </BoxContainer>
</Control>
